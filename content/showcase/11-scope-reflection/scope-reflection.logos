# a scope is a node: it knows the one it stands in and
# holds one field, self, its nodes in order
x := i32 1,
g := (
    a := i32 1,
    b := a + 1,
    print «{here.scope.scope == x:scope}» # up: true
    b
),
s := g:start.rhs,   # g's := node, then its right side
print «{s.scope == here.scope}»   # true: one up
print «{s.self.size}»             # 4: four lines
print «{s.self[0].lhs:name}»      # a
print «{s.self[0].rhs:type == i32}» # true
print «{s.self[1].rhs.lhs:name}»  # a, read in b

# caller: inside a constructor, where its word stood
mut seen := here.scope,
w := type (
    parse = ( seen = caller.scope, tape.remove(0) )
),
h := ( z := i32 3, w, z ),   # w used inside h
print «{seen.scope == here.scope}» # true: one up
