# the language defines itself: a power operator `^`,
# written in ordinary Logos and used in the same file,
# over integers and floats, with any real exponent

# ln(m * 2^k) = 2 atanh((m-1)/(m+1)) + k ln 2
ln := fn (x := f64 ?) -> f64 (
    mut m := x,
    mut k := f64 0.0,
    while m >= 2.0 ( m = m / 2.0, k = k + 1.0 ),
    while m < 1.0 ( m = m * 2.0, k = k - 1.0 ),
    t := (m - 1.0) / (m + 1.0),
    t2 := t * t,
    mut term := t,
    mut sum := f64 0.0,
    mut n := f64 1.0,
    while n < 60.0 (
        sum = sum + term / n,
        term = term * t2,
        n = n + 2.0
    ),
    2.0 * sum + k * 0.6931471805599453
),

# exp(k ln 2 + r) = 2^k exp(r), with |r| < ln 2
exp := fn (y := f64 ?) -> f64 (
    k := i64(y / 0.6931471805599453),
    r := y - f64(k) * 0.6931471805599453,
    mut term := f64 1.0,
    mut sum := f64 1.0,
    mut n := f64 1.0,
    while n < 30.0 (
        term = term * r / n,
        sum = sum + term,
        n = n + 1.0
    ),
    mut i := i64 0,
    if k >= 0 (
        while i < k ( sum = sum * 2.0, i = i + 1 )
    ) else (
        while i > k ( sum = sum / 2.0, i = i - 1 )
    ),
    sum
),

^ := type (
    lhs := ?,
    rhs := ?,
    output_type := type ?,

    share parse_rank = *.parse_rank + 1,
    share associativity = right,
    share parse = (
        tape[0]:type = ^,
        tape[0].lhs = tape[-1],
        tape[0].rhs = tape[1],
        # a float on either side, or a fraction
        # as the exponent, makes the result a float
        if tape[-1]:type == f64
                or tape[1]:type == f64 (
            tape[0].output_type = f64
        ) else ( if tape[-1]:type == f32
                or tape[1]:type == f32 (
            tape[0].output_type = f32
        ) else ( if tape[1]:type == rational_number
                and not (tape[1]:type ⊆ i64) (
            tape[0].output_type = f64
        ) else (
            tape[0].output_type = tape[-1]:type
        ) ) ),
        tape.is_constructed[0] = true,
        tape.remove(1),
        tape.remove(-1)
    ),
    share run = (
        if (f64(rhs) == f64(i64(rhs))) (
            # a whole exponent multiplies
            mut power := output_type 1,
            mut times := i64(rhs),
            mut factor := output_type(lhs),
            if times < 0 (
                if not (output_type == f64
                    or output_type == f32
                    or output_type == rational_number)
                    error «integer to a negative power»,
                factor = output_type 1 / factor,
                times = 0 - times
            ),
            for 0..times ( power = power * factor ),
            power
        ) else ( if (output_type == f64
                     or output_type == f32) (
            # any other goes through exp and ln
            base := f64(lhs),
            if base < 0.0
                error «a negative base to a fraction»,
            if base == 0.0 ( output_type 0 ) else (
                output_type(exp(f64(rhs) * ln(base)))
            )
        ) else ( error «a fraction needs a float» ) )
    )
),

f := fn (x := i32 ?) -> i32 ( x ^ 3 + 1 ),
f.compile(),
print «{f(2)}»,       # 9
x := f64 2.0,
print «{x ^ 0.5}»,    # 1.4142135623730954
print «{x ^ -2}»      # 0.25
