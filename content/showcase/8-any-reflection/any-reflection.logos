# with ^ from the tab before: every part of it is a
# node the program can read, and reading runs nothing
e := 2 ^ 3,
print «{e}»                          # 8
print «{(2 ^ 3).lhs} {(2 ^ 3).rhs}»  # 2 3, not run
print «{e:start.rhs:dyad.type == ^}» # true: a ^ node
print «{^.parse_rank > *.parse_rank}» # binds tighter
print «{^.associativity == right}»   # true
print «{^.arity} {^.roles[0]}»       # 2 lhs
print «{^.fields}»                   # lhs rhs output
print «{^.run}»                      # its run body
print «{^.parse}»                    # its parse body
